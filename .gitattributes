# Shell scripts run inside Linux containers (and Git Bash / WSL) and must keep
# LF line endings even when the repo is checked out on Windows with
# core.autocrlf=true. CRLF breaks the shebang and every line ("\r: not found").
*.sh        text eol=lf
Caddyfile   text eol=lf
Dockerfile  text eol=lf
*.sql       text eol=lf
.env*       text eol=lf

# PowerShell / batch files are Windows-native
*.ps1       text eol=crlf
*.bat       text eol=crlf
*.cmd       text eol=crlf
